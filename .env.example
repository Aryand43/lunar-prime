# Lunar Prime configuration. Export the variables you need in the backend's environment (for example
# `set -a; source .env; set +a` before starting uvicorn); nothing reads this file automatically. Everything is optional: with nothing set, simulation works fully and the mission analyst is
# disabled with an explanatory message. Secrets are read only by the backend; never put them in
# NEXT_PUBLIC_* variables or the frontend.

# --- SPICE ---------------------------------------------------------------------------------------
# LUNAR_PRIME_KERNEL_DIR=backend/kernels

# --- Mission analyst: language model (Anthropic) ---------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...            # enables the analyst; usage is billed by Anthropic
# ANTHROPIC_BASE_URL=                     # optional gateway/proxy URL
# LUNAR_PRIME_LLM_MODEL=claude-opus-5-5
# LUNAR_PRIME_LLM_EFFORT=medium           # low | medium | high | xhigh | max
# LUNAR_PRIME_LLM_MAX_TOKENS=16000        # output cap per model call
# LUNAR_PRIME_LLM_TIMEOUT_S=90
# LUNAR_PRIME_LLM_FALLBACKS=default       # server-side refusal fallback; "off" to disable
# LUNAR_PRIME_CHAT_TOKEN_BUDGET=300000    # total tokens per user message across tool rounds
# LUNAR_PRIME_CHAT_MAX_TOOL_ROUNDS=8
# LUNAR_PRIME_LLM_ASSUME_CREDENTIALS=1    # enable when credentials come from an `ant auth login` profile
# LUNAR_PRIME_CHAT_DISABLED=1             # force-disable the analyst

# --- Mission analyst: embeddings (optional) ---------------------------------------------------------
# Without these, a local feature-hashing embedder is used (lexical similarity only, no network, no cost).
# Any OpenAI-compatible /embeddings endpoint works, e.g. Voyage AI:
# LUNAR_PRIME_EMBED_BASE_URL=https://api.voyageai.com/v1
# LUNAR_PRIME_EMBED_MODEL=voyage-3.5
# LUNAR_PRIME_EMBED_API_KEY=...
# LUNAR_PRIME_EMBED_DIM=1024
# Changing model or dimension creates a new Qdrant collection; old vectors are never mixed in.

# --- Persistence -----------------------------------------------------------------------------------
# LUNAR_PRIME_DB_PATH=backend/.data/lunar_prime.db     # SQLite: runs, sessions, messages, summaries

# --- Vector store (Qdrant) ---------------------------------------------------------------------------
# Local (embedded, persistent, single process) is the default:
# LUNAR_PRIME_QDRANT_PATH=backend/.data/qdrant
# Server mode for concurrent / multi-worker deployments:
# LUNAR_PRIME_QDRANT_URL=http://localhost:6333
# LUNAR_PRIME_QDRANT_API_KEY=

# --- HTTP ------------------------------------------------------------------------------------------
# LUNAR_PRIME_CORS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ------------------------------------------------------------------------------
# BACKEND_URL=http://127.0.0.1:8000     # where Next.js proxies /api/* (read at build/start time)
